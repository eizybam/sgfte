<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%--
  Settings screen body, shared between the two areas.

  Goes as a fragment rather than duplicated in both JSPs because they are
  literally the same screen: only the shell changes (admin has a sidebar,
  the portal does not). If a setting is added tomorrow, it is added once.
--%>
<div class="settings">

    <%-- ---- Profile (read-only) ---------------------------------------- --%>
    <section class="settings__card">
        <h2 class="settings__title">Tu perfil</h2>

        <%--
          La foto.

          La ruta se arma con el servlet_path del forward —el mismo truco que el
          action del formulario de contraseña— porque este fragmento se pinta
          desde /admin/ajustes y desde /app/ajustes, y cada uno tiene que
          pegarle a su propia URL para que lo filtre su propio filtro.

          Fíjate en lo que NO lleva: ningún id. El endpoint sirve siempre la
          foto de quien tiene la sesión, así que no hay nada que cambiar en la
          URL para pedir la de otra persona.
        --%>
        <c:set var="ajustes" value="${requestScope['jakarta.servlet.forward.servlet_path']}"/>

        <div class="settings__photo">
            <c:choose>
                <c:when test="${hasPhoto}">
                    <img class="settings__avatar" src="${ctx}${ajustes}/foto" alt="Tu foto de perfil">
                </c:when>
                <c:otherwise>
                    <%-- Sin foto, la inicial: un hueco gris se lee como un error de carga. --%>
                    <div class="settings__avatar settings__avatar--empty">
                        ${fn:escapeXml(fn:substring(sessionScope.user.fullName, 0, 1))}
                    </div>
                </c:otherwise>
            </c:choose>

            <%-- enctype multipart o el navegador manda el NOMBRE del archivo, no el archivo. --%>
            <form method="post" action="${ctx}${ajustes}/foto"
                  enctype="multipart/form-data" class="settings__photo-form">

                <c:if test="${not empty photoErrors}">
                    <div class="alert alert--error">
                        <ul><c:forEach var="e" items="${photoErrors}"><li>${e}</li></c:forEach></ul>
                    </div>
                </c:if>

                <label class="register__label" for="photo">Cambiar foto</label>
                <%-- Sin .register__control: esa caja dibuja el marco de un campo
                     de texto, y aquí dentro lo único que hay es un botón. --%>
                <input class="register__input" type="file" id="photo" name="photo"
                       accept="image/png, image/jpeg, image/webp" required>
                <p class="settings__note">PNG, JPG o WEBP, máximo 2 MB. Sólo se ve en esta pantalla.</p>

                <div class="settings__actions">
                    <button type="submit" class="btn btn--primary">Guardar foto</button>
                </div>
            </form>
        </div>

        <dl class="settings__list">
            <div class="settings__row">
                <dt>Nombre</dt>
                <dd>${fn:escapeXml(sessionScope.user.fullName)}</dd>
            </div>
            <div class="settings__row">
                <dt>Correo</dt>
                <dd>${fn:escapeXml(sessionScope.user.email)}</dd>
            </div>
            <div class="settings__row">
                <dt>Rol</dt>
                <dd>${sessionScope.user.admin ? 'Administrador' : 'Tarjetahabiente'}</dd>
            </div>
            <c:if test="${not empty sessionScope.user.employeeCode}">
                <div class="settings__row">
                    <dt>Código de empleado</dt>
                    <dd class="mono">${fn:escapeXml(sessionScope.user.employeeCode)}</dd>
                </div>
            </c:if>
            <div class="settings__row">
                <dt>ID de usuario</dt>
                <dd class="mono">${sessionScope.user.id}</dd>
            </div>
        </dl>

        <p class="settings__note">
            Estos datos los administra el área de administración. Si algo está
            mal, pídeles que lo corrijan desde tu ficha de empleado.
        </p>
    </section>

    <%-- ---- Password ---------------------------------------------------- --%>
    <section class="settings__card">
        <h2 class="settings__title">Cambiar contraseña</h2>

        <c:if test="${not empty settingsErrors}">
            <div class="alert alert--error">
                <ul><c:forEach var="e" items="${settingsErrors}"><li>${e}</li></c:forEach></ul>
            </div>
        </c:if>

        <form method="post" action="${ctx}${requestScope['jakarta.servlet.forward.servlet_path']}" autocomplete="off">

            <label class="register__label" for="currentPassword">Contraseña actual</label>
            <div class="register__control">
                <input class="register__input" type="password" id="currentPassword"
                       name="currentPassword" autocomplete="current-password" required>
            </div>

            <label class="register__label" for="newPassword">Nueva contraseña</label>
            <div class="register__control">
                <input class="register__input" type="password" id="newPassword"
                       name="newPassword" minlength="8" autocomplete="new-password" required>
            </div>

            <label class="register__label" for="confirmPassword">Confirmar nueva contraseña</label>
            <div class="register__control">
                <input class="register__input" type="password" id="confirmPassword"
                       name="confirmPassword" minlength="8" autocomplete="new-password" required>
            </div>

            <p class="settings__note">Mínimo 8 caracteres, distinta de la actual.</p>

            <div class="settings__actions">
                <button type="submit" class="btn btn--primary">Actualizar contraseña</button>
            </div>
        </form>
    </section>

    <%-- ---- Session --------------------------------------------------------- --%>
    <section class="settings__card settings__card--wide">
        <h2 class="settings__title">Sesión</h2>
        <p class="settings__note">
            Tu sesión se cierra sola tras 30 minutos sin actividad. Ciérrala a
            mano si estás en un equipo compartido.
        </p>
        <form method="post" action="${ctx}/logout" class="settings__actions">
            <button type="submit" class="btn btn--secondary">Cerrar sesión</button>
        </form>
    </section>
</div>
