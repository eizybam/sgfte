<%--
  Cabecera compartida del área del tarjetahabiente.

  Uso: la página fija pageTitle con c:set, incluye este fragmento y cierra con
  app-bottom.jspf. Mira app/home.jsp como ejemplo de referencia.

  NO escribas directivas de include dentro de un comentario JSP aquí: Jasper
  las ejecuta igual (parseFileDirectives no respeta los comentarios) y si el
  ejemplo apunta a este archivo, se incluye a sí mismo → StackOverflowError.
--%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${pageTitle} · SGFTE</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/sgfte.css">
</head>
<body>
<%@ include file="/WEB-INF/jsp/partials/icons.jspf" %>

<div class="portal">

    <div class="portal-nav">
        <div class="portal-nav__brand">
            <span class="portal-nav__mark">SGFTE</span>
            <span class="portal-nav__who">${sessionScope.user.fullName}</span>
        </div>
        <nav class="portal-nav__links">
            <a href="${pageContext.request.contextPath}/app/home">Mis cuentas</a>
            <a href="${pageContext.request.contextPath}/app/transferencia">Transferir</a>
            <form method="post" action="${pageContext.request.contextPath}/logout">
                <button type="submit" class="btn btn--secondary" style="padding:6px 12px; font-size:13px;">
                    Cerrar sesión
                </button>
            </form>
        </nav>
    </div>

    <c:if test="${not empty success}">
        <div class="alert alert--ok">${success}</div>
    </c:if>
    <c:if test="${not empty errors}">
        <div class="alert alert--error">
            <ul><c:forEach var="e" items="${errors}"><li>${e}</li></c:forEach></ul>
        </div>
    </c:if>
