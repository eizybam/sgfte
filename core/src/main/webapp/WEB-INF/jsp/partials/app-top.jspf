<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%--
  Cascarón del área del tarjetahabiente · marco Figma "Vista principal de
  Tarjetahabiente" (64:4).

  La cabecera es la misma pieza que la del admin —mismo alto, mismos 85px entre
  enlaces, mismo bloque de usuario y misma regla inferior—, así que reutiliza
  .app-header y sólo cambia a dónde apuntan los enlaces. Lo que no tiene es
  panel lateral: aquí el contenido ocupa las tres columnas del marco.

  Uso: la página fija pageTitle y activeNav con c:set, incluye este fragmento y
  cierra con app-bottom.jspf.

  NO escribas directivas de include dentro de un comentario JSP aquí: Jasper
  las ejecuta igual (parseFileDirectives no respeta los comentarios) y si el
  ejemplo apunta a este archivo, se incluye a sí mismo → StackOverflowError.
--%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${pageTitle} · SGFTE</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
          rel="stylesheet">
    <link rel="stylesheet"
          href="${pageContext.request.contextPath}/assets/css/sgfte.css?v=${applicationScope.assetsVersion}">
    <%@ include file="/WEB-INF/jsp/partials/canvas-fit.jspf" %>
</head>
<body class="portal-body">
<%@ include file="/WEB-INF/jsp/partials/icons.jspf" %>

<c:set var="ctx" value="${pageContext.request.contextPath}"/>

<div class="pshell">

    <header class="app-header">
        <nav class="app-header__nav">
            <a class="app-header__link ${activeNav == 'home' ? 'is-active' : ''}"
               href="${ctx}/app/home">Dashboard</a>
            <a class="app-header__link ${activeNav == 'movements' ? 'is-active' : ''}"
               href="${ctx}/app/movimientos">Movimientos</a>
            <a class="app-header__link ${activeNav == 'notifications' ? 'is-active' : ''}"
               href="${ctx}/app/notificaciones">Notificaciones</a>
        </nav>

        <div class="app-header__user">
            <a href="${ctx}/app/home" title="Ajustes">
                <img class="app-header__gear" src="${ctx}/assets/img/icons/settings.png" alt="Ajustes">
            </a>
            <%--
              El bloque de usuario cierra sesión, igual que en el admin. El ID
              que enseña el marco ("AD38NDW2") es el código de empleado, no el
              id de la fila: es el que el empleado reconoce como suyo.
            --%>
            <form method="post" action="${ctx}/logout">
                <button type="submit" class="app-header__who" title="Cerrar sesión">
                    <span class="app-header__name">${fn:escapeXml(sessionScope.user.fullName)}</span>
                    <span class="app-header__id">ID: ${fn:escapeXml(sessionScope.user.employeeCode)}</span>
                </button>
            </form>
        </div>
    </header>

    <main class="pmain">
