<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%--
  Modal "Transferencia" · marco Figma 111:2.

  El marco lo dibuja como pantalla completa, con un título y un subtítulo
  encima, pero es un pop-up: se abre sobre el panel o sobre la vista de cuenta,
  desde el botón "Transferir a compañero". Sólo entra la tarjeta; el título y el
  subtítulo del marco quedan fuera, como en los demás modales.

  El origen sí es un desplegable: son TUS cuentas, dos o tres, y ya están en la
  petición. El destino no: se teclea el identificador que tu compañero te pasó y
  se comprueba contra el servidor mientras escribes. Antes era un <select> con
  todas las cuentas elegibles de la empresa — una lista con scroll que, además,
  enseñaba a cada empleado qué cuentas tienen todos sus compañeros.

  Quien lo incluya debe haber dejado en la petición `myAccounts`.
--%>
<div class="modal-scrim" id="transfer-modal" hidden>
    <div class="modal xfer__card" role="dialog" aria-modal="true" aria-labelledby="xfer-title">
        <h2 class="modal__title xfer__modal-title" id="xfer-title">Transferencia</h2>
        <p class="xfer__modal-lead">
            Solo puedes transferir entre cuentas del mismo propósito (ej. Gasolina → Gasolina).
        </p>

        <form class="xfer__form" method="post" action="${ctx}/app/transferencia">

            <label class="xfer__label" for="sourceId">CUENTA ORIGEN</label>
            <div class="xfer__control">
                <svg class="xfer__icon" width="16" height="12" aria-hidden="true"><use href="#i-card-slot"/></svg>
                <select class="xfer__input" id="sourceId" name="sourceId" required>
                    <option value="" disabled ${empty fixedSourceId ? 'selected' : ''}>Selecciona una cuenta</option>
                    <c:forEach var="a" items="${myAccounts}">
                        <option value="${a.id}" ${fixedSourceId == a.id ? 'selected' : ''}>
                            ${fn:escapeXml(a.purpose)} · ${fn:escapeXml(a.accountNumber)}
                        </option>
                    </c:forEach>
                </select>
                <svg class="xfer__chev" width="12.64" height="6.82" aria-hidden="true"><use href="#i-chevron"/></svg>
            </div>

            <label class="xfer__label" for="destNumber">CUENTA DESTINO</label>
            <div class="xfer__control">
                <%--
                  El identificador de la cuenta de tu compañero, tal cual él lo
                  ve en su pantalla ("GAS-48HSY"). Se teclea, no se elige: para
                  llenar un desplegable habría que enseñarle a cada empleado qué
                  cuentas tienen todos los demás, y eso es exactamente lo que
                  RNF-05 no quiere. Si no te lo pasaron, no puedes transferirle.

                  Lo que viaja al servidor es el texto, no un id resuelto en el
                  navegador: quien traduce identificador → cuenta es el servlet,
                  con la misma consulta que responde aquí abajo mientras escribes.
                --%>
                <svg class="xfer__icon" width="16" height="12" aria-hidden="true"><use href="#i-card-slot"/></svg>
                <input class="xfer__input" type="text" id="destNumber" name="destNumber"
                       placeholder="Ej. GAS-48HSY" autocomplete="off" spellcheck="false"
                       maxlength="20" required aria-describedby="dest-check">
            </div>
            <%-- role=status + aria-live: un lector de pantalla anuncia el
                 veredicto sin que haya habido navegación. --%>
            <p class="xfer__note" id="dest-check" role="status" aria-live="polite"></p>

            <label class="xfer__label" for="amount">MONTO</label>
            <div class="xfer__control">
                <svg class="xfer__icon" width="16.74" height="17" aria-hidden="true"><use href="#i-cash-app"/></svg>
                <input class="xfer__input" type="number" step="0.01" min="0.01"
                       id="amount" name="amount" placeholder="0.00" required>
            </div>

            <label class="xfer__label" for="description">CONCEPTO</label>
            <div class="xfer__control xfer__control--area">
                <textarea class="xfer__input" id="description" name="description"
                          maxlength="200" placeholder="Ej. Pago comida, renta..."></textarea>
            </div>

            <div class="xfer__actions">
                <button type="button" class="btn btn--secondary btn--hero" data-close-transfer>Cancelar</button>
                <button type="submit" class="btn btn--primary btn--hero">
                    <svg width="24" height="24" aria-hidden="true"><use href="#i-arrows"/></svg>
                    Confirmar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var scrim = document.getElementById("transfer-modal");
        if (!scrim) return;

        var source = document.getElementById("sourceId");
        var dest = document.getElementById("destNumber");
        var verdict = document.getElementById("dest-check");
        var confirm = scrim.querySelector('button[type="submit"]');
        var ctx = "${ctx}";
        var lastFocused = null;
        var timer = null;     // antirrebote del identificador
        var seq = 0;          // nº de petición, contra respuestas fuera de orden

        /*
          ¿Sirve lo que lleva escrito?

          El propósito no se comprueba aquí: se le pregunta al servidor, porque
          la cuenta destino es de otra persona y el navegador no sabe —ni debe
          saber— de qué propósito es. Por eso hace falta el origen: la regla es
          "mismo propósito que la cuenta de la que sale el dinero".
        */
        function check() {
            var typed = dest.value.trim();

            if (!source.value || !typed) {
                verdict.innerHTML = "";
                confirm.disabled = false;   // que lo diga el servidor, no un botón muerto
                return;
            }

            var mine = ++seq;
            fetch(ctx + "/app/transferencia/validar"
                    + "?sourceId=" + encodeURIComponent(source.value)
                    + "&dest=" + encodeURIComponent(typed),
                { credentials: "same-origin" })
                .then(function (res) {
                    // Sesión caducada: AppAuthFilter contesta con un 302 al login
                    // y fetch lo sigue sin avisar. Sin esto acabarías metiendo la
                    // página de login dentro del modal.
                    if (res.redirected) { window.location.reload(); return null; }
                    if (!res.ok) throw new Error("HTTP " + res.status);
                    return res.text();
                })
                .then(function (html) {
                    if (html === null || mine !== seq) return;   // respuesta vieja
                    verdict.innerHTML = html;
                    confirm.disabled = !verdict.querySelector("[data-ok]");
                })
                .catch(function () {
                    // Si la comprobación no llega, NO se bloquea el envío: esto
                    // es una cortesía, y el servidor valida igual al confirmar.
                    verdict.innerHTML = "";
                    confirm.disabled = false;
                });
        }

        function open() {
            lastFocused = document.activeElement;
            scrim.hidden = false;
            verdict.innerHTML = "";
            confirm.disabled = false;
            source.focus();
        }

        function close() {
            scrim.hidden = true;
            if (lastFocused) lastFocused.focus();
        }

        document.querySelectorAll("[data-open-transfer]").forEach(function (b) {
            b.addEventListener("click", open);
        });
        document.querySelectorAll("[data-close-transfer]").forEach(function (b) {
            b.addEventListener("click", close);
        });

        // Cambiar de origen puede cambiar el propósito, así que el veredicto
        // anterior deja de valer aunque el identificador siga siendo el mismo.
        source.addEventListener("change", check);

        // Antirrebote: 300 ms sin teclear antes de preguntar. Sin esto,
        // "GAS-48HSY" son nueve consultas a Oracle.
        dest.addEventListener("input", function () {
            clearTimeout(timer);
            timer = setTimeout(check, 300);
        });

        scrim.addEventListener("mousedown", function (e) { if (e.target === scrim) close(); });
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !scrim.hidden) close();
        });
    })();
</script>
