<%--
  El ojo para ver lo que se está tecleando en un campo de contraseña.

  No lleva marcado en ningún JSP: el script busca TODOS los input[type=password]
  de la página y les cuelga el botón. Hay seis repartidos en tres archivos
  (login, crear contraseña y el cambio de contraseña de ajustes, que además es
  el mismo parcial para admin y portal), y colgar el botón a mano en cada uno
  significaría acordarse seis veces —y otra vez con el séptimo—. Es el mismo
  criterio del bloqueo de scroll de admin-bottom.jspf.

  Se incluye en los dos cascarones y en las dos pantallas de auth, que son las
  cuatro puertas por las que se llega a un campo de contraseña.

  El botón va DESPUÉS del input en el DOM, así que el tabulador lo encuentra en
  el orden natural: primero se escribe, luego se decide si mirar.
--%>
<script>
    (function () {
        var OJO =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
            '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>' +
            '<circle cx="12" cy="12" r="3"/></svg>';

        var OJO_TACHADO =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
            '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>' +
            '<path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>' +
            '<path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>' +
            '<line x1="1" y1="1" x2="23" y2="23"/></svg>';

        document.querySelectorAll('input[type="password"]').forEach(function (input) {
            var host = input.parentElement;
            if (!host || host.querySelector('.pw-eye')) return;

            var boton = document.createElement('button');
            // type=button y no el submit que sería por omisión dentro de un
            // <form>: sin esto, mirar la contraseña envía el formulario.
            boton.type = 'button';
            boton.className = 'pw-eye';
            boton.innerHTML = OJO;
            boton.setAttribute('aria-label', 'Mostrar contraseña');
            boton.setAttribute('aria-pressed', 'false');

            boton.addEventListener('click', function () {
                var visible = input.type === 'text';
                input.type = visible ? 'password' : 'text';
                boton.innerHTML = visible ? OJO : OJO_TACHADO;
                boton.setAttribute('aria-label', visible ? 'Mostrar contraseña' : 'Ocultar contraseña');
                boton.setAttribute('aria-pressed', String(!visible));

                // Devolver el foco al campo y dejar el cursor al final: si no,
                // el foco se queda en el botón y hay que volver a hacer clic
                // para seguir escribiendo.
                var fin = input.value.length;
                input.focus();
                try { input.setSelectionRange(fin, fin); } catch (e) { /* algunos navegadores no lo permiten en type=text recién cambiado */ }
            });

            host.appendChild(boton);
            // La clase deja que el CSS haga hueco al botón sólo cuando existe.
            host.classList.add('has-pw-eye');
        });
    })();
</script>
