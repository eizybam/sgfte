SGFTE_MAIL_HOST=smtp.gmail.com
SGFTE_MAIL_PORT=465
SGFTE_MAIL_SSL=true
SGFTE_MAIL_USER=your_email@gmail.com
SGFTE_MAIL_PASSWORD=mail_password
SGFTE_APP_BASE_URL=http://localhost:8080
ORACLE_PASSWORD=oracle_password
APP_USER=user_password
APP_USER_PASSWORD=app_password

# Secreto compartido con el banco para firmar las notificaciones de depósito
# (V12). Si no se define, la app arranca con un valor de desarrollo que se
# anuncia en la pantalla del simulador. Genera uno con: openssl rand -hex 32
SGFTE_BANK_SECRET=bank_webhook_secret
